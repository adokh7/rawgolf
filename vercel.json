{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "crons": [
        {
            "path": "/api/cron/weekly?template=field",
            "schedule": "0 9 * * 1"
        }
    ],
    "redirects": [
        {
            "source": "/what-beginners-actually-search",
            "destination": "/news-2026-what-beginners-actually-search",
            "permanent": true
        },
        {
            "source": "/news-2026-lee-westwood-liv-golf-bedminster-different-course",
            "destination": "/guides-playing-golf-in-your-fifties-distance-loss",
            "permanent": true
        },
        {
            "source": "/news/tour-championship-winners-losers-friday-scheffler-round-2",
            "destination": "/news-2026-tour-championship-winners-losers-friday",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/public/fonts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/public/(.*)\\.(webp|avif|png|jpg|jpeg|gif|svg|ico|mp4|webm)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(woff2|woff|ttf|otf)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(html|xml|txt|json)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
